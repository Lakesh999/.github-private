{
  "Hugh": {
    "AgentsPath": "./agents",
    "DocsPath": "./docs",
    "OrchestratorPath": "./.orchestrator",
    "Timeouts": {
      "VisionPhase": "00:10:00",
      "ResearchPhase": "00:30:00",
      "ResearchSubPhasePerPhase": "00:15:00",
      "PlanningPhase": "00:20:00",
      "PlanningSubPhasePerPhase": "00:15:00",
      "ReviewPhase": "00:15:00",
      "CodingPhasePerPhase": "00:20:00",
      "InteractiveVisionPhase": "00:30:00"
    },
    "Autonomous": {
      "Enabled": true,
      "AcceptRecommendationsOnly": true,
      "InteractivePhases": [ "Vision" ],
      "MaxInteractiveTurns": 15
    },
    "Copilot": {
      "Model": "claude-opus-4.8",
      "MaxRetryAttempts": 3,
      "RetryBaseDelayMs": 2000,
      "CompactionThreshold": 0.8,
      "BufferExhaustionThreshold": 0.95,
      "AutoRestart": true,
      "CliPath": null,
      "MaxPhaseRetries": 2
    },
    "AgentDiscovery": {
      "Enabled": true,
      "PinnedOrg": null,
      "RepositoryName": ".github-private",
      "AgentsDirectory": "agents",
      "CacheTtl": "01:00:00",
      "DiscoveryTimeout": "00:00:30"
    },
    "Solution": {
      "TriageTimeout": "00:03:00",
      "ClarificationTimeout": "00:30:00",
      "DecompositionTimeout": "00:15:00",
      "MaxClarificationTurns": 20
    },
    "Verification": {
      "Enabled": true,
      "BuildCommand": "dotnet build",
      "TestCommand": "dotnet test",
      "MaxVerificationRetries": 3,
      "VerifyBuildPerSubPhase": true
    },
    "Git": {
      "CommitPerPhase": true,
      "CommitMessagePrefix": "[Hugh]"
    },
    "Review": {
      "MaxReviewCycles": 2,
      "RequireCleanApproval": false
    },
    "Coding": {
      "Granularity": "task",
      "VerifyBuildPerTask": false
    }
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
